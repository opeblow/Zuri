# Zuri backend configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=8000
NODE_ENV=development

# Auth — change this! Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# AI assistant (optional — leave blank to disable)
OPENAI_API_KEY=

# Paystack (optional — used for transfers / bank lookups)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Monnify (required for real money movement — the hackathon rail)
# https://sandbox.monnify.com · Bills Payment needs activation from
# integration-support@monnify.com before airtime/data/electricity/cable can vend.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Your disbursement wallet account number - Dashboard > Disbursement page.
# Required for wallet-balance reads and single transfers.
MONNIFY_WALLET_ACCOUNT_NUMBER=

# --- Demo controls ---
# FORCE_DEMO=1 runs a bulletproof simulated demo (no OTP, no network) even when
# real keys are present. Omit/empty to use the live sandbox.
FORCE_DEMO=0
# Welcome bonus credited to every new account on signup (in kobo). Set 0 to disable.
# Default 20_000_000 kobo = ₦200,000. This is what funds the money-send demo.
WELCOME_BONUS_KOBO=20000000

# --- Direct debit (mandates) ---
# Uses MONNIFY_CONTRACT_CODE above. Mandate start date cannot be in the past.

# --- Webhooks ---
# Dashboard > Developers > Webhook URLs -> point "transaction completion" at
#   https://<your-host>/api/webhooks/monnify
# Verified with HMAC-SHA512 via the 'monnify-signature' header (production only;
# sandbox omits it). Use an ngrok tunnel to receive webhooks locally.