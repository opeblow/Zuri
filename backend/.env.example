# Zuri backend configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=8000
NODE_ENV=development

# Auth — change this! Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# AI assistant — chat, tool-calling (log transactions / create goals), Whisper
# speech-to-text, and OpenAI TTS. Leave blank to run without the AI features.
OPENAI_API_KEY=

# Comma-separated extra origins allowed to call the API (besides localhost:5173/3000).
ALLOWED_ORIGINS=
