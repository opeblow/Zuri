# Zuri backend configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=8000
NODE_ENV=development

# Auth — change this! Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# AI assistant (optional — leave blank to disable)
OPENAI_API_KEY=

# Paystack (optional — used for transfers / bank lookups)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Monnify (optional / legacy)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=